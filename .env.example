# Public Supabase project identifiers. Copy to ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Team configuration. Never use NEXT_PUBLIC for private keys.
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
# TEAM_INVITE_SECRET=YOUR_PERSISTENT_RANDOM_SERVER_SECRET
# CRM_APP_ORIGIN=https://YOUR_REACHABLE_CRM_HOST
# TEAM_TRUST_PROXY=false

# Operator-only configuration belongs in ignored .env.setup.local.
# SUPABASE_DB_URL=YOUR_POSTGRES_CONNECTION_STRING
# SUPABASE_DB_CA_FILE=C:/private/path/to/TRUSTED_SUPABASE_CA.crt

# Manual invitations require no SMTP. Optional legacy mail settings:
# TEAM_MAIL_HOST=YOUR_SMTP_HOST
# TEAM_MAIL_PORT=587
# TEAM_MAIL_USER=YOUR_SMTP_USERNAME
# TEAM_MAIL_PASSWORD=YOUR_SMTP_PASSWORD
# TEAM_MAIL_FROM=CRM <verified-sender@your-domain.example>

# Step 6A: test form is opt-in and restricted to a localhost CRM_APP_ORIGIN.
# CRM_ENABLE_INGESTION_TEST_FORM=false
# Optional separate >=43-character server secret; otherwise the existing Team secret
# is used with a separate HMAC purpose. Never put this in NEXT_PUBLIC variables.
# INGESTION_RATE_SECRET=YOUR_LONG_RANDOM_SERVER_ONLY_SECRET
# Enable only behind a trusted proxy that overwrites x-forwarded-for.
# INGESTION_TRUST_PROXY=false

# Step 12: server-only read-only Meta connection; configure only this CRM app.
# META_APP_ID=YOUR_META_APP_ID
# META_APP_SECRET=YOUR_SERVER_ONLY_META_APP_SECRET
# META_GRAPH_VERSION=v26.0
# META_TOKEN_ENCRYPTION_KEY=YOUR_PERSISTENT_64_HEX_CHARACTER_KEY
# Separate restricted worker login; never use postgres/admin here.
# META_WORKER_DATABASE_URL=YOUR_CRM_META_RUNTIME_SESSION_POOLER_URL
# META_WORKER_CA_FILE=C:/private/path/to/TRUSTED_SUPABASE_CA.crt
