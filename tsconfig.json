{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-check/types/**/*.ts",
    ".next-check/dev/types/**/*.ts",
    ".next-team-check/types/**/*.ts",
    ".next-team-check/dev/types/**/*.ts",
    ".next-manual-check/types/**/*.ts",
    ".next-manual-check/dev/types/**/*.ts",
    ".next-calls-check/types/**/*.ts",
    ".next-calls-check/dev/types/**/*.ts",
    ".next-followups-check/types/**/*.ts",
    ".next-followups-check/dev/types/**/*.ts",
    ".next-ingestion-check/types/**/*.ts",
    ".next-ingestion-check/dev/types/**/*.ts",
    ".next-imports-check/types/**/*.ts",
    ".next-imports-check/dev/types/**/*.ts",
    ".next-catalog-check/types/**/*.ts",
    ".next-catalog-check/dev/types/**/*.ts",
    ".next-views-check/types/**/*.ts",
    ".next-views-check/dev/types/**/*.ts",
    ".next-review-check/types/**/*.ts",
    ".next-review-check/dev/types/**/*.ts",
    ".next-acceptance-check/types/**/*.ts",
    ".next-acceptance-check/dev/types/**/*.ts",
    ".next-performance-check/types/**/*.ts",
    ".next-performance-check/dev/types/**/*.ts",
    ".next-attribution-check/types/**/*.ts",
    ".next-attribution-check/dev/types/**/*.ts",
    ".next-campaign-check/types/**/*.ts",
    ".next-campaign-check/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
