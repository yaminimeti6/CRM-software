# Public Supabase project identifiers. Copy to ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Team configuration. Never use NEXT_PUBLIC for private keys.
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
# TEAM_INVITE_SECRET=YOUR_PERSISTENT_RANDOM_SERVER_SECRET
# CRM_APP_ORIGIN=https://YOUR_REACHABLE_CRM_HOST
# TEAM_TRUST_PROXY=false

# Operator-only configuration belongs in ignored .env.setup.local.
# SUPABASE_DB_URL=YOUR_POSTGRES_CONNECTION_STRING
# SUPABASE_DB_CA_FILE=C:/private/path/to/TRUSTED_SUPABASE_CA.crt

# Manual invitations require no SMTP. Optional legacy mail settings:
# TEAM_MAIL_HOST=YOUR_SMTP_HOST
# TEAM_MAIL_PORT=587
# TEAM_MAIL_USER=YOUR_SMTP_USERNAME
# TEAM_MAIL_PASSWORD=YOUR_SMTP_PASSWORD
# TEAM_MAIL_FROM=CRM <verified-sender@your-domain.example>
